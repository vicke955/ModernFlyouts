<Page x:Class="ModernFlyouts.Navigation.ExitPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ModernFlyouts" xmlns:ui="http://schemas.modernwpf.com/2019"
      xmlns:controls="clr-namespace:ModernFlyouts.Controls"
      xmlns:utils="clr-namespace:ModernFlyouts.Utilities"
      xmlns:resx="clr-namespace:ModernFlyouts.Properties"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800">
    <controls:ScrollViewerEx>
        <ui:SimpleStackPanel Margin="12,0,0,12" VerticalAlignment="Bottom">
            <Button
                MinWidth="170"
                Style="{DynamicResource ButtonRevealStyle}"
                Content="{x:Static resx:Strings.ExitItem}" Click="ExitButton_Click" />
        </ui:SimpleStackPanel>
    </controls:ScrollViewerEx>
</Page>
